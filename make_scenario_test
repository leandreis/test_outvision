<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Make Scenario Test Runner — Beaufort</title>
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; background: #f5f5f3; color: #1a1a1a; min-height: 100vh; padding: 2rem 1rem; }
  .container { max-width: 780px; margin: 0 auto; }
  h1 { font-size: 18px; font-weight: 600; margin-bottom: 4px; }
  .subtitle { font-size: 13px; color: #666; margin-bottom: 1.5rem; }
  .global-config { background: #fff; border: 0.5px solid #ddd; border-radius: 10px; padding: 14px 16px; margin-bottom: 1rem; display: flex; align-items: center; gap: 10px; }
  .global-config label { font-size: 12px; color: #666; white-space: nowrap; }
  .global-config input { flex: 1; font-size: 12px; font-family: monospace; border: 0.5px solid #ddd; border-radius: 6px; padding: 6px 10px; background: #fafafa; }
  .global-config input:focus { outline: none; border-color: #888; background: #fff; }
  .reset-btn { font-size: 11px; padding: 5px 12px; border: 0.5px solid #ddd; border-radius: 6px; background: #fff; cursor: pointer; color: #444; white-space: nowrap; }
  .reset-btn:hover { background: #f0f0f0; }
  .summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; margin-bottom: 1.5rem; }
  .stat { background: #fff; border-radius: 8px; padding: 12px; text-align: center; border: 0.5px solid #e8e8e8; }
  .stat-n { font-size: 24px; font-weight: 600; color: #1a1a1a; }
  .stat-n.ok { color: #0f6e56; }
  .stat-n.fail { color: #a32d2d; }
  .stat-l { font-size: 11px; color: #888; margin-top: 2px; }
  .scenario { background: #fff; border: 0.5px solid #ddd; border-radius: 10px; margin-bottom: 10px; overflow: hidden; }
  .scenario-header { display: flex; align-items: center; gap: 10px; padding: 11px 14px; cursor: pointer; user-select: none; border-bottom: 0.5px solid transparent; }
  .scenario-header:hover { background: #fafafa; }
  .scenario-header.open { border-bottom-color: #eee; }
  .chevron { font-size: 9px; color: #aaa; transition: transform 0.2s; flex-shrink: 0; }
  .chevron.open { transform: rotate(90deg); }
  .scenario-title { font-size: 13px; font-weight: 500; flex: 1; }
  .scenario-badge { font-size: 10px; background: #f0f0f0; color: #666; padding: 2px 8px; border-radius: 20px; }
  .scenario-config { padding: 8px 14px; background: #fafafa; border-bottom: 0.5px solid #eee; display: flex; align-items: center; gap: 8px; }
  .scenario-config label { font-size: 11px; color: #888; white-space: nowrap; }
  .scenario-config input { flex: 1; font-size: 11px; font-family: monospace; border: 0.5px solid #ddd; border-radius: 5px; padding: 5px 8px; background: #fff; }
  .scenario-config input:focus { outline: none; border-color: #888; }
  .trigger-label { font-size: 10px; color: #aaa; padding: 4px 14px 8px; background: #fafafa; border-bottom: 0.5px solid #eee; }
  .branches { padding: 8px; display: none; }
  .branches.open { display: block; }
  .branch { border: 0.5px solid #e8e8e8; border-radius: 8px; padding: 10px 12px; margin-bottom: 6px; }
  .branch:last-child { margin-bottom: 0; }
  .branch-top { display: flex; align-items: center; gap: 8px; }
  .branch-info { flex: 1; min-width: 0; }
  .branch-name { font-size: 12px; font-weight: 500; color: #1a1a1a; }
  .branch-payload { font-size: 10px; font-family: monospace; color: #999; margin-top: 2px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .status-pill { display: flex; align-items: center; gap: 5px; font-size: 11px; color: #888; white-space: nowrap; }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: #ddd; flex-shrink: 0; }
  .dot.ok { background: #1d9e75; }
  .dot.fail { background: #e24b4a; }
  .dot.running { background: #ef9f27; animation: blink 0.8s infinite; }
  @keyframes blink { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .fire-btn { font-size: 11px; padding: 5px 14px; border: 0.5px solid #ccc; border-radius: 6px; background: #fff; cursor: pointer; color: #333; white-space: nowrap; flex-shrink: 0; }
  .fire-btn:hover:not(:disabled) { background: #f5f5f5; border-color: #999; }
  .fire-btn:disabled { opacity: 0.4; cursor: not-allowed; }
  .fire-btn.ok { border-color: #1d9e75; color: #0f6e56; background: #e1f5ee; }
  .fire-btn.fail { border-color: #e24b4a; color: #a32d2d; background: #fcebeb; }
  .response { font-size: 11px; font-family: monospace; padding: 6px 10px; border-radius: 6px; margin-top: 8px; display: none; word-break: break-all; white-space: pre-wrap; }
  .response.show { display: block; }
  .response.ok { background: #e1f5ee; color: #085041; border-left: 2px solid #1d9e75; }
  .response.fail { background: #fcebeb; color: #791f1f; border-left: 2px solid #e24b4a; }
  .edit-payload { font-size: 10px; color: #aaa; cursor: pointer; text-decoration: underline; margin-top: 3px; display: inline-block; }
  .payload-editor { display: none; margin-top: 6px; }
  .payload-editor textarea { width: 100%; font-size: 11px; font-family: monospace; border: 0.5px solid #ddd; border-radius: 5px; padding: 6px 8px; resize: vertical; min-height: 80px; background: #fafafa; }
  .payload-editor textarea:focus { outline: none; border-color: #888; background: #fff; }
</style>
</head>
<body>
<div class="container">

  <h1>Make — Scenario Test Runner</h1>
  <p class="subtitle">Beaufort · Post-migration validation · Configure les webhooks puis fire chaque branche</p>

  <div class="global-config">
    <label>Webhook global</label>
    <input type="text" id="global-webhook" placeholder="https://hook.eu2.make.com/xxxxxxxxxxxxxxxx" />
    <button class="reset-btn" onclick="resetAll()">Reset tous</button>
  </div>

  <div class="summary">
    <div class="stat"><div class="stat-n" id="s-total">0</div><div class="stat-l">testées</div></div>
    <div class="stat"><div class="stat-n ok" id="s-ok">0</div><div class="stat-l">passed</div></div>
    <div class="stat"><div class="stat-n fail" id="s-fail">0</div><div class="stat-l">failed</div></div>
  </div>

  <div id="scenarios"></div>

</div>

<script>
const SCENARIOS = [
  {
    id: "s1",
    title: "1.1 — Update project : linked boards + create folder",
    trigger: "when an item move in Projekt S...",
    branches: [
      {
        id: "b1a",
        name: "Branche A — sans linked board",
        payload: { event: "item_moved", item_id: "TEST_001", board_id: null, linked_board_id: null, folder_id: null }
      },
      {
        id: "b1b",
        name: "Branche B — avec linked board",
        payload: { event: "item_moved", item_id: "TEST_002", board_id: "123456789", linked_board_id: "987654321", folder_id: null }
      },
      {
        id: "b1c",
        name: "Branche C — folder déjà existant",
        payload: { event: "item_moved", item_id: "TEST_003", board_id: "123456789", linked_board_id: "987654321", folder_id: "555555" }
      }
    ]
  },
  {
    id: "s2",
    title: "2.2 — Send 1st email in consultant draft",
    trigger: "when Status der ersten E-Mail ch...",
    branches: [
      {
        id: "b2a",
        name: "Branche A — statut = Draft",
        payload: { event: "status_changed", item_id: "TEST_010", status: "Draft", consultant_email: "test@beaufort.de" }
      },
      {
        id: "b2b",
        name: "Branche B — statut != Draft",
        payload: { event: "status_changed", item_id: "TEST_011", status: "Active", consultant_email: "test@beaufort.de" }
      },
      {
        id: "b2c",
        name: "Branche C — email consultant vide",
        payload: { event: "status_changed", item_id: "TEST_012", status: "Draft", consultant_email: "" }
      }
    ]
  },
  {
    id: "s3",
    title: "2.1 — Send 1st email automated",
    trigger: "when Status der ersten E-Mail ch...",
    branches: [
      {
        id: "b3a",
        name: "Branche A — envoi automatique OK",
        payload: { event: "status_changed", item_id: "TEST_020", status: "Send", automated: true, email: "candidate@test.com" }
      },
      {
        id: "b3b",
        name: "Branche B — pas de destinataire",
        payload: { event: "status_changed", item_id: "TEST_021", status: "Send", automated: true, email: null }
      }
    ]
  },
  {
    id: "s4",
    title: "1.1 — Update linked boards when item is created [PEOPLE-DIAGNOSTIK]",
    trigger: "when back_status of the Projekt...",
    branches: [
      {
        id: "b4a",
        name: "Branche A — back_status actif",
        payload: { event: "item_created", item_id: "TEST_030", back_status: "active", linked_boards: ["111", "222"] }
      },
      {
        id: "b4b",
        name: "Branche B — back_status inactif",
        payload: { event: "item_created", item_id: "TEST_031", back_status: "inactive", linked_boards: [] }
      }
    ]
  }
];

const state = {};
SCENARIOS.forEach(s => s.branches.forEach(b => {
  state[b.id] = { status: "idle", response: null, payload: JSON.stringify(b.payload, null, 2) };
}));

function getWebhook(scenarioId) {
  const specific = document.getElementById("wh-" + scenarioId);
  const val = specific ? specific.value.trim() : "";
  if (val) return val;
  return document.getElementById("global-webhook").value.trim() || null;
}

function updateSummary() {
  const all = Object.values(state);
  document.getElementById("s-total").textContent = all.filter(s => s.status !== "idle").length;
  document.getElementById("s-ok").textContent = all.filter(s => s.status === "ok").length;
  document.getElementById("s-fail").textContent = all.filter(s => s.status === "fail").length;
}

function resetAll() {
  Object.keys(state).forEach(k => { state[k].status = "idle"; state[k].response = null; });
  renderAll();
}

function toggleEditor(branchId) {
  const ed = document.getElementById("editor-" + branchId);
  ed.style.display = ed.style.display === "block" ? "none" : "block";
}

async function fireTest(branchId, scenarioId) {
  const url = getWebhook(scenarioId);
  if (!url) { alert("Configure d'abord le webhook URL !"); return; }
  const ta = document.getElementById("ta-" + branchId);
  let payload;
  try { payload = JSON.parse(ta ? ta.value : "{}"); }
  catch(e) { alert("JSON invalide dans le payload : " + e.message); return; }
  state[branchId].status = "running";
  state[branchId].response = null;
  renderBranch(branchId);
  updateSummary();
  try {
    const res = await fetch(url, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload)
    });
    const text = await res.text();
    state[branchId].status = res.ok ? "ok" : "fail";
    state[branchId].response = "HTTP " + res.status + "\n\n" + text.substring(0, 500);
  } catch(e) {
    state[branchId].status = "fail";
    state[branchId].response = "Erreur réseau : " + e.message + "\n\nVérifie que le webhook Make est actif et que le scénario est ON.";
  }
  renderBranch(branchId);
  updateSummary();
}

function renderBranch(branchId) {
  const s = state[branchId];
  const dot = document.getElementById("dot-" + branchId);
  const stxt = document.getElementById("stxt-" + branchId);
  const btn = document.getElementById("btn-" + branchId);
  const box = document.getElementById("resp-" + branchId);
  if (!dot) return;
  dot.className = "dot" + (s.status === "ok" ? " ok" : s.status === "fail" ? " fail" : s.status === "running" ? " running" : "");
  stxt.textContent = { idle: "—", running: "envoi...", ok: "passed", fail: "failed" }[s.status];
  btn.disabled = s.status === "running";
  btn.textContent = s.status === "running" ? "..." : "Fire";
  btn.className = "fire-btn" + (s.status === "ok" ? " ok" : s.status === "fail" ? " fail" : "");
  if (s.response) {
    box.className = "response show " + (s.status === "ok" ? "ok" : "fail");
    box.textContent = s.response;
  } else {
    box.className = "response";
    box.textContent = "";
  }
}

function renderAll() {
  const container = document.getElementById("scenarios");
  container.innerHTML = SCENARIOS.map(s => `
    <div class="scenario">
      <div class="scenario-header" id="sh-${s.id}" onclick="toggleScenario('${s.id}')">
        <span class="chevron" id="chevron-${s.id}">&#9654;</span>
        <span class="scenario-title">${s.title}</span>
        <span class="scenario-badge">${s.branches.length} branches</span>
      </div>
      <div class="scenario-config">
        <label>Webhook</label>
        <input type="text" id="wh-${s.id}" placeholder="laisser vide = utiliser le webhook global" />
      </div>
      <div class="trigger-label">Trigger : ${s.trigger}</div>
      <div class="branches" id="branches-${s.id}">
        ${s.branches.map(b => `
          <div class="branch">
            <div class="branch-top">
              <div class="branch-info">
                <div class="branch-name">${b.name}</div>
                <div class="branch-payload">${JSON.stringify(b.payload).substring(0, 90)}...</div>
                <span class="edit-payload" onclick="toggleEditor('${b.id}')">modifier le payload</span>
                <div class="payload-editor" id="editor-${b.id}">
                  <textarea id="ta-${b.id}">${JSON.stringify(b.payload, null, 2)}</textarea>
                </div>
              </div>
              <div class="status-pill">
                <div class="dot" id="dot-${b.id}"></div>
                <span id="stxt-${b.id}">—</span>
              </div>
              <button class="fire-btn" id="btn-${b.id}" onclick="fireTest('${b.id}','${s.id}')">Fire</button>
            </div>
            <div class="response" id="resp-${b.id}"></div>
          </div>
        `).join("")}
      </div>
    </div>
  `).join("");
  SCENARIOS.forEach(s => s.branches.forEach(b => renderBranch(b.id)));
}

function toggleScenario(id) {
  const b = document.getElementById("branches-" + id);
  const c = document.getElementById("chevron-" + id);
  const h = document.getElementById("sh-" + id);
  const open = b.classList.toggle("open");
  c.classList.toggle("open", open);
  h.classList.toggle("open", open);
}

renderAll();
updateSummary();
</script>
</body>
</html>
